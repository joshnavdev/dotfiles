# Resolve the repo location through the ~/.zshrc symlink (zsh :A = realpath)
DOTFILES="${${(%):-%x}:A:h}"
export DOTFILES
XDG_CONFIG_HOME="$DOTFILES/.config"
ZSH_CUSTOM="$XDG_CONFIG_HOME/zsh"
export EDITOR="nvim"
export HOMEBREW_NO_AUTO_UPDATE=1

source $ZSH_CUSTOM/init.zsh
source $HOME/antigen.zsh

# Antigen
antigen use oh-my-zsh

antigen bundle git
antigen bundle zsh-users/zsh-autosuggestions
antigen bundle zsh-users/zsh-syntax-highlighting

antigen apply

# Per-tool config, generated by tools/optional/*.sh (machine specific, git-ignored)
for _f in "$ZSH_CUSTOM"/conf.d/*.zsh(N); do
  source "$_f"
done
unset _f

# Starship
eval "$(starship init zsh)"

# bun completions
[ -s "/home/josnavdev/.bun/_bun" ] && source "/home/josnavdev/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
